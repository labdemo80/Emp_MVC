
<%- include("../partials/header", { title: "Employee List" }) %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold">Employees</h2>
        <p class="text-muted">Manage your organization employees</p>
    </div>

    <a href="/employees/create" class="btn btn-primary">
        + Add Employee
    </a>
</div>

<% if (success === "created" || success === "updated" || success === "deleted") { %>
    <div class="alert alert-success">
        Employee <%= success %> successfully!
    </div>
<% } %>

<div class="card shadow-sm">
    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Salary</th>
                        <th>Department</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    <% if (employees.length === 0) { %>

                        <tr>
                            <td colspan="6" class="text-center py-4">
                                No employees found.
                            </td>
                        </tr>

                    <% } %>

                    <% employees.forEach((emp, index) => { %>

                        <tr>
                            <td><%= index + 1 %></td>
                            <td class="fw-semibold"><%= emp.name %></td>
                            <td><%= emp.email %></td>
                            <td>₹<%= emp.salary.toLocaleString("en-IN") %></td>
                            <td>
                                <span class="badge bg-info text-dark">
                                    <%= emp.department %>
                                </span>
                            </td>

                            <td>
                                <a href="/employees/edit/<%= emp._id %>"
                                   class="btn btn-sm btn-warning">
                                    ✏️
                                </a>

                                <form action="/employees/delete/<%= emp._id %>"
                                      method="POST"
                                      class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to delete this employee?')">

                                    <button type="submit"
                                            class="btn btn-sm btn-danger">
                                        🗑️
                                    </button>

                                </form>
                            </td>
                        </tr>

                    <% }) %>

                </tbody>

            </table>

        </div>

    </div>
</div>

<%- include("../partials/footer") %>
